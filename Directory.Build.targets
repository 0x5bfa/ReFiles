<Project>
	<Target Name="ValidateConsumerAssemblyReferences" BeforeTargets="CoreCompile" Condition="'$(EnforceConsumerReferenceBoundary)' == 'true'">
		<ItemGroup>
			<_ForbiddenConsumerReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'Files.Core' Or '%(Filename)' == 'Files.Providers' Or '%(Filename)' == 'Files.Core.ProviderContracts' Or '%(Filename)' == 'FluentFTP' Or '%(Filename)' == 'SevenZipSharp' Or '%(Filename)' == 'System.Management'" />
		</ItemGroup>
		<Error Condition="'@(_ForbiddenConsumerReference)' != ''" Text="Consumer compiler references must not include implementation assemblies: @(_ForbiddenConsumerReference->'%(Filename)', ', ')." />
	</Target>
	<Target Name="ValidateProviderAssemblyReferences" BeforeTargets="CoreCompile"
		Condition="'$(MSBuildProjectName)' == 'Files.Core' Or '$(MSBuildProjectName)' == 'Files.Providers' Or '$(MSBuildProjectName)' == 'Files.Core.ProviderContracts'">
		<ItemGroup>
			<_InvalidProviderReference Include="@(ReferencePath)" Condition="'$(MSBuildProjectName)' != 'Files.Providers' And ('%(Filename)' == 'Files.Providers' Or '%(Filename)' == 'FluentFTP' Or '%(Filename)' == 'SevenZipSharp' Or '%(Filename)' == 'System.Management')" />
			<_InvalidProviderReference Include="@(ReferencePath)" Condition="'$(MSBuildProjectName)' != 'Files.Core' And '%(Filename)' == 'Files.Core'" />
		</ItemGroup>
		<Error Condition="'@(_InvalidProviderReference)' != ''" Text="Provider/runtime isolation forbids these compiler references in $(MSBuildProjectName): @(_InvalidProviderReference->'%(Filename)', ', ')." />
	</Target>
</Project>
