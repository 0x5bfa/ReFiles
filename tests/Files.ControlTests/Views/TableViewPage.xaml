<Page
	x:Class="Files.ControlTests.Views.TableViewPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.Controls"
	xmlns:local="using:Files.ControlTests.Views">

	<Page.Resources>
		<DataTemplate x:Key="NameCellTemplate" x:DataType="local:TableViewSampleItem">
			<StackPanel Orientation="Horizontal" Spacing="8">
				<FontIcon FontSize="16" Glyph="&#xE8B7;" />
				<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
			</StackPanel>
		</DataTemplate>
	</Page.Resources>

	<controls:TableView
		Height="320"
		ItemsSource="{x:Bind Items, Mode=OneWay}"
		RowHeight="36">
		<controls:TableView.Columns>
			<controls:TableViewTemplateColumn
				Binding="Name"
				CellTemplate="{StaticResource NameCellTemplate}"
				ColumnWidth="240"
				Header="Name"
				IsPrimary="True" />
			<controls:TableViewTextColumn Binding="Type" ColumnWidth="140" Header="Type" />
			<controls:TableViewDateColumn Binding="Modified" ColumnWidth="180" Header="Date modified" />
			<controls:TableViewCheckBoxColumn Binding="IsPinned" ColumnWidth="72" Header="Pinned" />
		</controls:TableView.Columns>
	</controls:TableView>
</Page>
