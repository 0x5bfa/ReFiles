<Page
	x:Class="Files.UITests.Views.ThemedIconPerformancePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<StackPanel Spacing="12">
		<StackPanel Orientation="Horizontal" Spacing="8">
			<TextBlock
				VerticalAlignment="Center"
				Text="Icon count" />
			<NumberBox
				x:Name="IconCountBox"
				Width="140"
				Maximum="10000"
				Minimum="1"
				Value="1000" />
			<Button
				x:Name="RunButton"
				Click="RunButton_Click"
				Content="Run measurement" />
			<ProgressRing
				x:Name="ProgressRing"
				Width="24"
				Height="24"
				IsActive="False" />
		</StackPanel>

		<TextBlock
			x:Name="ResultText"
			Text="Warm-up and five measured runs are performed."
			TextWrapping="Wrap" />

		<Canvas x:Name="IconCanvas" />
	</StackPanel>
</Page>
