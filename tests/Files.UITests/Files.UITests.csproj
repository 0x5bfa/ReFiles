<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<RootNamespace>Files.UITests</RootNamespace>
		<UseWinUI>true</UseWinUI>
		<WinUIDSKReferences>false</WinUIDSKReferences>
		<EnableMsixTooling>false</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<EnableMSTestRunner>true</EnableMSTestRunner>
		<GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
		<IsTestProject>true</IsTestProject>
		<SelfContained>false</SelfContained>
		<PrependPriInitialPath>true</PrependPriInitialPath>
		<ShouldComputeInputPris>true</ShouldComputeInputPris>
		<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
	</PropertyGroup>

	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<ApplicationDefinition Include="App.xaml" />
		<ProjectCapability Include="TestContainer" />
		<Manifest Include="$(ApplicationManifest)" />
		<Content Include="Assets\**\*.png" />
		<Content Include="Data\**\*.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Files\Files.csproj" AdditionalProperties="WindowsAppSDKSelfContained=false;WindowsAppSdkBootstrapInitialize=false;WindowsAppSdkDeploymentManagerInitialize=false" />
		<ProjectReference Include="..\..\src\Files.Controls\Files.Controls.csproj" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<!--<PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" />-->
		<PackageReference Include="Microsoft.WindowsAppSDK" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

</Project>
