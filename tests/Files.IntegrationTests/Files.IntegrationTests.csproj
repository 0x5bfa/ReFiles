<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<OutputType>Exe</OutputType>
		<!-- The WinRT component copies a private hostfxr; launch the managed test entry point through dotnet. -->
		<UseAppHost>false</UseAppHost>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<EnableMSTestRunner>true</EnableMSTestRunner>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Files.Core\Files.Core.csproj" />
		<ProjectReference Include="..\..\src\Files.BackgroundServer\Files.BackgroundServer.csproj"
			AdditionalProperties="SelfContained=false;OutputPath=bin\IntegrationReference\$(Platform)\$(Configuration)\;IntermediateOutputPath=obj\IntegrationReference\$(Platform)\$(Configuration)\" />
	</ItemGroup>

</Project>
