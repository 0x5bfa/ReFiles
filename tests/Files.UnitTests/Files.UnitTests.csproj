<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<EnableMSTestRunner>true</EnableMSTestRunner>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Files.Core\Files.Core.csproj" />
		<ProjectReference Include="..\..\src\Files.Providers\Files.Providers.csproj" />
		<ProjectReference Include="..\..\src\Files.Hosting\Files.Hosting.csproj" />
	</ItemGroup>

	<!-- Exercise the production settings facades without loading WinUI. -->
	<ItemGroup>
		<Compile Include="../../src/Files/Settings/ISettingsStorage.cs" Link="Settings/ISettingsStorage.cs" />
		<Compile Include="../../src/Files/Settings/JsonViewSettingsStore.cs" Link="Settings/JsonViewSettingsStore.cs" />
		<Compile Include="../../src/Files/Settings/StoredBrowseViewState.cs" Link="Settings/StoredBrowseViewState.cs" />
		<Compile Include="../../src/Files/Settings/ViewSettingsJsonContext.cs" Link="Settings/ViewSettingsJsonContext.cs" />
		<Compile Include="../Files.UITests/PresentationTests/JsonViewSettingsStoreTests.cs" Link="Settings/JsonViewSettingsStoreTests.cs" />
	</ItemGroup>
	<ItemGroup>
		<None Update="ArchiveFixtures\*.7z" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
