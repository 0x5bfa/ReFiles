<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
		<EnforceConsumerReferenceBoundary>true</EnforceConsumerReferenceBoundary>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<CsWinRTComponent>true</CsWinRTComponent>
		<CsWinRTWindowsMetadata>$(TargetWindowsVersion)</CsWinRTWindowsMetadata>
		<CsWinRTEnableLogging>true</CsWinRTEnableLogging>
	</PropertyGroup>

	<ItemGroup>
		<Manifest Include="app.manifest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
		<PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Files.Core.Contracts\Files.Core.Contracts.csproj" />
		<ProjectReference Include="..\Files.Hosting\Files.Hosting.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Files.IntegrationTests" />
	</ItemGroup>

</Project>
