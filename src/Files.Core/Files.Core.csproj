<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- The COM source generator emits CS1591 for inherited members; source files still use the .editorconfig error rule. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<PackageId>ReFiles.Core</PackageId>
		<Title>ReFiles.Core</Title>
		<Authors>Files Community</Authors>
		<Version>0.1.0-alpha</Version>
		<Description>UI-independent storage, browsing, capability, and Windows Shell foundation for ReFiles.</Description>
		<PackageLicenseFile>LICENSE-MPL</PackageLicenseFile>
		<PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/0x5bfa/ReFiles</RepositoryUrl>
		<PackageTags>Files ReFiles FileManager Storage Windows Shell</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentFTP" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
		<PackageReference Include="SevenZipSharp" />
		<PackageReference Include="System.Management" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE-MPL" Pack="true" PackagePath="" Visible="false" />
		<None Update="PACKAGE.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Files.UnitTests" />
		<InternalsVisibleTo Include="Files.Benchmarks" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Native\7z64.dll" Pack="true" PackagePath="runtimes/win-x64/native/7z64.dll" TargetPath="7z64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
			<CopyToOutputDirectory Condition="'$(Platform)' != 'x64'">Never</CopyToOutputDirectory>
			<CopyToPublishDirectory Condition="'$(Platform)' != 'x64'">Never</CopyToPublishDirectory>
		</None>
		<None Update="Native\7zArm64.dll" Pack="true" PackagePath="runtimes/win-arm64/native/7zArm64.dll" TargetPath="7zArm64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
			<CopyToOutputDirectory Condition="'$(Platform)' != 'arm64'">Never</CopyToOutputDirectory>
			<CopyToPublishDirectory Condition="'$(Platform)' != 'arm64'">Never</CopyToPublishDirectory>
		</None>
		<None Update="Native\7zip-LICENSE.txt" Pack="true" PackagePath="contentFiles/any/any/7zip-LICENSE.txt" PackageCopyToOutput="true" TargetPath="7zip-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Native\7zip-LGPL.txt" Pack="true" PackagePath="contentFiles/any/any/7zip-LGPL.txt" PackageCopyToOutput="true" TargetPath="7zip-LGPL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Native\SevenZipSharp-LICENSE.txt" Pack="true" PackagePath="contentFiles/any/any/SevenZipSharp-LICENSE.txt" PackageCopyToOutput="true" TargetPath="SevenZipSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Native\SevenZipSharp-GPL.txt" Pack="true" PackagePath="contentFiles/any/any/SevenZipSharp-GPL.txt" PackageCopyToOutput="true" TargetPath="SevenZipSharp-GPL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
