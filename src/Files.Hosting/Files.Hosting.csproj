<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>ReFiles.Hosting</PackageId>
		<Version>0.1.0</Version>
		<Authors>0x5bfa</Authors>
		<Description>Typed process startup for ReFiles consumer runtimes.</Description>
		<PackageLicenseFile>LICENSE-MPL</PackageLicenseFile>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Files.Core.Contracts/Files.Core.Contracts.csproj" />
		<ProjectReference Include="../Files.Core/Files.Core.csproj" PrivateAssets="compile" />
		<ProjectReference Include="../Files.Core.ProviderContracts/Files.Core.ProviderContracts.csproj" PrivateAssets="compile" />
		<ProjectReference Include="../Files.Providers/Files.Providers.csproj" PrivateAssets="compile" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<None Include="../../LICENSE-MPL" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

</Project>
