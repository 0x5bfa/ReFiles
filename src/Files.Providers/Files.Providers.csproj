<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>ReFiles.Providers</PackageId>
		<Version>0.1.0</Version>
		<Authors>0x5bfa</Authors>
		<Description>Windows Shell, FTP and archive providers for ReFiles.</Description>
		<PackageLicenseFile>LICENSE-MPL</PackageLicenseFile>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Files.Core.Contracts/Files.Core.Contracts.csproj" />
		<ProjectReference Include="../Files.Core.ProviderContracts/Files.Core.ProviderContracts.csproj" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
		<PackageReference Include="FluentFTP" PrivateAssets="compile" />
		<PackageReference Include="SevenZipSharp" PrivateAssets="compile" />
		<PackageReference Include="System.Management" PrivateAssets="compile" />
		<InternalsVisibleTo Include="Files.UnitTests" />
		<InternalsVisibleTo Include="Files.Benchmarks" />
		<None Include="../../LICENSE-MPL" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>
</Project>
