<UserControl
	x:Class="Files.Views.DetailsFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.Controls"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<UserControl.Resources>
		<DataTemplate x:Key="DetailsPrimaryCellTemplate" x:DataType="vm:BrowseItemViewModel">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="16" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Grid
					Grid.Column="0"
					Width="16"
					Height="16"
					VerticalAlignment="Center">
					<FontIcon
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="16"
						Glyph="&#xE8B7;"
						Opacity="0.45"
						Visibility="{x:Bind DefaultIconVisibility, Mode=OneWay}" />
					<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
				</Grid>

				<TextBlock
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind Name}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="DetailsGroupHeaderTemplate" x:DataType="vm:BrowseItemGroupViewModel">
			<StackPanel Padding="12,10,12,6" Orientation="Horizontal" Spacing="8">
				<TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
				<TextBlock Opacity="0.65" Text="{x:Bind CountText}" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<controls:TableView
		x:Name="ItemTable"
		ColumnsSource="{x:Bind ViewModel.DetailsColumns, Mode=OneWay}"
		GroupHeaderTemplate="{StaticResource DetailsGroupHeaderTemplate}"
		ItemsSource="{x:Bind ViewModel.ItemsViewSource.View, Mode=OneWay}"
		PrimaryCellTemplate="{StaticResource DetailsPrimaryCellTemplate}"
		RowHeight="{x:Bind ViewModel.DetailsRowHeight, Mode=OneWay}" />

</UserControl>
