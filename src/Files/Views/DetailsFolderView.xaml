<UserControl
	x:Class="Files.Views.DetailsFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<ListView
		x:Name="ItemList"
		IsMultiSelectCheckBoxEnabled="False"
		ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
		SelectionMode="Extended">
		<ListView.ItemContainerStyle>
			<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			</Style>
		</ListView.ItemContainerStyle>
		<ListView.ItemTemplate>
			<DataTemplate x:DataType="vm:BrowseItemViewModel">
				<Grid ColumnSpacing="12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="100" />
						<ColumnDefinition Width="2*" />
					</Grid.ColumnDefinitions>
					<Grid Width="16" Height="16">
						<FontIcon
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="16"
							Glyph="&#xE8B7;"
							Opacity="0.5" />
						<Viewbox Width="16" Height="16" Stretch="Uniform">
							<Image Source="{x:Bind Thumbnail, Mode=OneWay}" />
						</Viewbox>
					</Grid>
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						Text="{x:Bind Name}" />
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						Opacity="0.7"
						Text="{x:Bind Kind}" />
					<TextBlock
						Grid.Column="3"
						VerticalAlignment="Center"
						Opacity="0.7"
						Text="{x:Bind ReferenceText}"
						TextTrimming="CharacterEllipsis" />
				</Grid>
			</DataTemplate>
		</ListView.ItemTemplate>
	</ListView>
</UserControl>
