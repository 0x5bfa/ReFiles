<UserControl
	x:Class="Files.Views.RootView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.Controls"
	xmlns:views="using:Files.Views"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<UserControl.Resources>
		<DataTemplate x:Key="NavigationSidebarFlyoutItemTemplate" x:DataType="vm:NavigationItemViewModel">
			<controls:SidebarItem
				controls:RightButtonDrag.IsEnabled="True"
				AutomationProperties.Name="{x:Bind Text}"
				CanDrag="{x:Bind CanDrag}"
				Icon="{x:Bind Icon, Mode=OneWay}"
				IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
				Item="{x:Bind}"
				MenuItemsSource="{x:Bind MenuItemsSource, Mode=OneWay}"
				SelectsOnInvoked="{x:Bind SelectsOnInvoked, Mode=OneWay}"
				Text="{x:Bind Text, Mode=OneWay}"
				ToolTip="{x:Bind ToolTip, Mode=OneWay}" />
		</DataTemplate>
		<DataTemplate x:Key="NavigationSidebarItemTemplate" x:DataType="controls:FlatSidebarItem">
			<controls:SidebarItem
				Margin="{x:Bind SectionGapMargin, Mode=OneWay}"
				controls:RightButtonDrag.IsEnabled="True"
				AutomationProperties.Name="{Binding Item.Text}"
				CanDrag="{Binding Item.CanDrag}"
				ContentOpacity="{x:Bind RowOpacity}"
				DataContext="{x:Bind}"
				Icon="{Binding Item.Icon, Mode=OneWay}"
				IsExpanded="{Binding Item.IsExpanded, Mode=TwoWay}"
				Item="{x:Bind Item}"
				MenuItemTemplate="{StaticResource NavigationSidebarFlyoutItemTemplate}"
				MenuItemsSource="{Binding Item.MenuItemsSource, Mode=OneWay}"
				NestingLevel="{x:Bind Depth}"
				SelectsOnInvoked="{Binding Item.SelectsOnInvoked, Mode=OneWay}"
				Text="{Binding Item.Text, Mode=OneWay}"
				ToolTip="{Binding Item.ToolTip, Mode=OneWay}" />
		</DataTemplate>
	</UserControl.Resources>

	<Grid RowSpacing="1">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<views:TabView x:Name="TabStrip" ViewModel="{x:Bind ViewModel.TabStrip, Mode=OneWay}" />

		<views:NavigationToolbar
			x:Name="NavigationToolbarView"
			Grid.Row="1"
			ViewModel="{x:Bind ViewModel.NavigationToolbar, Mode=OneWay}" />

		<controls:SidebarView
			x:Name="Sidebar"
			Grid.Row="2"
			AutomationProperties.AutomationId="Sidebar"
			DisplayMode="{x:Bind ViewModel.SidebarDisplayMode, Mode=TwoWay}"
			FooterMenuItemTemplate="{StaticResource NavigationSidebarItemTemplate}"
			FooterMenuItemsSource="{x:Bind ViewModel.SidebarFooterItems, Mode=OneWay}"
			ItemDragEnter="Sidebar_ItemDragEnter"
			ItemDragLeave="Sidebar_ItemDragLeave"
			ItemDragOver="Sidebar_ItemDragOver"
			ItemDragStarting="Sidebar_ItemDragStarting"
			ItemDropped="Sidebar_ItemDropped"
			ItemInvoked="Sidebar_ItemInvoked"
			MenuItemTemplate="{StaticResource NavigationSidebarItemTemplate}"
			MenuItemsSource="{x:Bind ViewModel.SidebarItems, Mode=OneWay}"
			OpenPaneLength="240"
			PaneBackgroundBrush="{ThemeResource ControlFillColorTransparentBrush}"
			SupportsExpansion="True">

			<controls:SidebarView.InnerContent>
				<Grid Padding="0,0,8,8" RowSpacing="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<views:ToolbarView x:Name="FolderToolbarView" ViewModel="{x:Bind ViewModel.Toolbar, Mode=OneWay}" />

					<Grid Grid.Row="1" ColumnSpacing="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition x:Name="PreviewPaneSplitterColumn" Width="0" />
							<ColumnDefinition
								x:Name="PreviewPaneColumn"
								Width="0"
								MinWidth="0" />
						</Grid.ColumnDefinitions>

						<views:PaneHost x:Name="PaneHostView" ViewModel="{x:Bind ViewModel.ActiveTab, Mode=OneWay}" />

						<controls:GridSplitter
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							IsTabStop="False"
							ResizeBehavior="PreviousAndNext"
							ResizeDirection="Columns" />

						<views:PreviewPane
							x:Name="PreviewPaneView"
							Grid.Column="2"
							IsTabStop="True"
							ViewModel="{x:Bind ViewModel.ActivePreview, Mode=OneWay}" />
					</Grid>

					<views:TerminalView Grid.Row="2" Visibility="Collapsed" />

					<views:InfoPane Grid.Row="3" Visibility="Collapsed" />
				</Grid>
			</controls:SidebarView.InnerContent>
		</controls:SidebarView>
	</Grid>
</UserControl>
