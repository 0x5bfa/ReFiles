<UserControl
	x:Class="Files.Views.RootView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.Controls"
	xmlns:views="using:Files.Views"
	x:Name="Root">

	<UserControl.Resources>
		<DataTemplate x:Key="NavigationSidebarFlyoutItemTemplate">
			<controls:SidebarItem
				AutomationProperties.Name="{Binding Text}"
				Icon="{Binding Icon, Mode=OneWay}"
				IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
				Item="{Binding}"
				MenuItemsSource="{Binding MenuItemsSource, Mode=OneWay}"
				SelectsOnInvoked="{Binding SelectsOnInvoked, Mode=OneWay}"
				Text="{Binding Text, Mode=OneWay}"
				ToolTip="{Binding ToolTip, Mode=OneWay}" />
		</DataTemplate>
	</UserControl.Resources>

	<Grid RowSpacing="1">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<views:TabView x:Name="TabStrip" ViewModel="{x:Bind ViewModel.TabStrip, Mode=OneWay}" />

		<views:NavigationToolbar Grid.Row="1" ViewModel="{x:Bind ViewModel.NavigationToolbar, Mode=OneWay}" />

		<controls:SidebarView
			x:Name="Sidebar"
			Grid.Row="2"
			AutomationProperties.AutomationId="Sidebar"
			DisplayMode="{x:Bind ViewModel.SidebarDisplayMode, Mode=TwoWay}"
			ItemInvoked="Sidebar_ItemInvoked"
			MenuItemsSource="{x:Bind ViewModel.SidebarItems, Mode=OneWay}"
			OpenPaneLength="240"
			PaneBackgroundBrush="{ThemeResource ControlFillColorTransparentBrush}"
			SupportsExpansion="True">

			<controls:SidebarView.MenuItemTemplate>
				<DataTemplate x:DataType="controls:FlatSidebarItem">
					<controls:SidebarItem
						Margin="{x:Bind SectionGapMargin, Mode=OneWay}"
						AutomationProperties.Name="{Binding Item.Text}"
						ContentOpacity="{x:Bind RowOpacity}"
						DataContext="{x:Bind}"
						Icon="{Binding Item.Icon, Mode=OneWay}"
						IsExpanded="{Binding Item.IsExpanded, Mode=TwoWay}"
						Item="{x:Bind Item}"
						MenuItemTemplate="{StaticResource NavigationSidebarFlyoutItemTemplate}"
						MenuItemsSource="{Binding Item.MenuItemsSource, Mode=OneWay}"
						NestingLevel="{x:Bind Depth}"
						SelectsOnInvoked="{Binding Item.SelectsOnInvoked, Mode=OneWay}"
						Text="{Binding Item.Text, Mode=OneWay}"
						ToolTip="{Binding Item.ToolTip, Mode=OneWay}" />
				</DataTemplate>
			</controls:SidebarView.MenuItemTemplate>

			<controls:SidebarView.InnerContent>
				<Grid Padding="0,0,8,8" RowSpacing="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<views:ToolbarView ViewModel="{x:Bind ViewModel.Toolbar, Mode=OneWay}" />

					<Grid Grid.Row="1" ColumnSpacing="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<!-- <ColumnDefinition Width="320" /> -->
						</Grid.ColumnDefinitions>

						<views:PaneHost ViewModel="{x:Bind ViewModel.ActiveTab, Mode=OneWay}" />

						<!--
						<views:PreviewPane
							x:Name="PreviewPaneView"
							Grid.Column="1"
							ViewModel="{x:Bind ViewModel.ActivePreview, Mode=OneWay}" />
						-->
					</Grid>

					<views:TerminalView Grid.Row="2" Visibility="Collapsed" />

					<views:InfoPane Grid.Row="3" Visibility="Collapsed" />
				</Grid>
			</controls:SidebarView.InnerContent>
		</controls:SidebarView>
	</Grid>
</UserControl>
