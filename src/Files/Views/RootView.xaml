<UserControl
	x:Class="Files.Views.RootView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:viewModels="using:Files.ViewModels"
	xmlns:views="using:Files.Views"
	x:Name="Root">
	<Grid RowSpacing="1">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<views:TabView x:Name="TabStrip" ViewModel="{x:Bind ViewModel.TabStrip, Mode=OneWay}" />

		<views:NavigationToolbar Grid.Row="1" ViewModel="{x:Bind ViewModel.NavigationToolbar, Mode=OneWay}" />

		<NavigationView
			x:Name="Sidebar"
			Grid.Row="2"
			IsBackButtonVisible="Collapsed"
			IsSettingsVisible="False"
			ItemInvoked="NavigationView_ItemInvoked"
			MenuItemsSource="{x:Bind ViewModel.NavigationItems, Mode=OneWay}"
			OpenPaneLength="240"
			PaneDisplayMode="Left">

			<NavigationView.Resources>
				<ResourceDictionary>
					<StaticResource x:Key="NavigationViewContentBackground" ResourceKey="ControlFillColorTransparentBrush" />
					<StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
					<Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
					<CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
				</ResourceDictionary>
			</NavigationView.Resources>

			<NavigationView.MenuItemTemplate>
				<DataTemplate x:DataType="viewModels:NavigationItemViewModel">
					<NavigationViewItem
						AutomationProperties.Name="{x:Bind Name}"
						Content="{x:Bind Name}"
						Icon="{x:Bind Icon, Mode=OneWay}"
						MenuItemsSource="{x:Bind Children, Mode=OneWay}"
						SelectsOnInvoked="{x:Bind SelectsOnInvoked}"
						Tag="{x:Bind}" />
				</DataTemplate>
			</NavigationView.MenuItemTemplate>

			<NavigationView.Content>
				<Grid RowSpacing="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<views:ToolbarView ViewModel="{x:Bind ViewModel.Toolbar, Mode=OneWay}" />

					<Grid Grid.Row="1" ColumnSpacing="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="320" />
						</Grid.ColumnDefinitions>

						<views:PaneHost ViewModel="{x:Bind ViewModel.ActiveTab, Mode=OneWay}" />

						<views:PreviewPane
							x:Name="PreviewPaneView"
							Grid.Column="1"
							ViewModel="{x:Bind ViewModel.ActivePreview, Mode=OneWay}" />
					</Grid>

					<views:TerminalView Grid.Row="2" Visibility="Collapsed" />

					<views:InfoPane Grid.Row="3" Visibility="Collapsed" />
				</Grid>
			</NavigationView.Content>
		</NavigationView>
	</Grid>
</UserControl>
