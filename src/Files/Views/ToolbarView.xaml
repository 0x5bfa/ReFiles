<UserControl
	x:Class="Files.Views.ToolbarView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root">
	<Grid
		Padding="8,4"
		Background="{ThemeResource CardBackgroundFillColorSecondary}"
		BackgroundSizing="InnerBorderEdge"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		ColumnSpacing="6"
		CornerRadius="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TextBlock
			VerticalAlignment="Center"
			FontWeight="SemiBold"
			Text="{x:Bind ViewModel.ActiveTabTitle, Mode=OneWay}" />
		<Button
			Grid.Column="1"
			ToolTipService.ToolTip="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
			AutomationProperties.Name="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
			IsEnabled="{x:Bind ViewModel.SortItemsCommand.IsEnabled, Mode=OneWay}">
			<FontIcon FontSize="18" Glyph="&#xE8CB;" />
			<Button.Flyout>
				<MenuFlyout Placement="Bottom">
					<MenuFlyoutSubItem Text="{x:Bind ViewModel.SortByLabel, Mode=OneWay}">
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="name"
							IsChecked="{x:Bind ViewModel.IsSortByName, Mode=OneWay}"
							Text="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="dateModified"
							IsChecked="{x:Bind ViewModel.IsSortByDateModified, Mode=OneWay}"
							Text="{x:Bind ViewModel.DateModifiedLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="dateCreated"
							IsChecked="{x:Bind ViewModel.IsSortByDateCreated, Mode=OneWay}"
							Text="{x:Bind ViewModel.DateCreatedLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="size"
							IsChecked="{x:Bind ViewModel.IsSortBySize, Mode=OneWay}"
							Text="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="type"
							IsChecked="{x:Bind ViewModel.IsSortByType, Mode=OneWay}"
							Text="{x:Bind ViewModel.TypeLabel, Mode=OneWay}" />
						<MenuFlyoutSeparator />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="ascending"
							IsChecked="{x:Bind ViewModel.IsSortAscending, Mode=OneWay}"
							Text="{x:Bind ViewModel.AscendingLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.SortItemsCommand.Command}"
							CommandParameter="descending"
							IsChecked="{x:Bind ViewModel.IsSortDescending, Mode=OneWay}"
							Text="{x:Bind ViewModel.DescendingLabel, Mode=OneWay}" />
					</MenuFlyoutSubItem>
					<MenuFlyoutSubItem Text="{x:Bind ViewModel.GroupByLabel, Mode=OneWay}">
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="none"
							IsChecked="{x:Bind ViewModel.IsGroupByNone, Mode=OneWay}"
							Text="{x:Bind ViewModel.NoneLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="name"
							IsChecked="{x:Bind ViewModel.IsGroupByName, Mode=OneWay}"
							Text="{x:Bind ViewModel.NameLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="dateModified"
							IsChecked="{x:Bind ViewModel.IsGroupByDateModified, Mode=OneWay}"
							Text="{x:Bind ViewModel.DateModifiedLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="dateCreated"
							IsChecked="{x:Bind ViewModel.IsGroupByDateCreated, Mode=OneWay}"
							Text="{x:Bind ViewModel.DateCreatedLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="size"
							IsChecked="{x:Bind ViewModel.IsGroupBySize, Mode=OneWay}"
							Text="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="type"
							IsChecked="{x:Bind ViewModel.IsGroupByType, Mode=OneWay}"
							Text="{x:Bind ViewModel.TypeLabel, Mode=OneWay}" />
						<MenuFlyoutSeparator />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="ascending"
							IsChecked="{x:Bind ViewModel.IsGroupAscending, Mode=OneWay}"
							Text="{x:Bind ViewModel.AscendingLabel, Mode=OneWay}" />
						<ToggleMenuFlyoutItem
							Command="{x:Bind ViewModel.GroupItemsCommand.Command}"
							CommandParameter="descending"
							IsChecked="{x:Bind ViewModel.IsGroupDescending, Mode=OneWay}"
							Text="{x:Bind ViewModel.DescendingLabel, Mode=OneWay}" />
					</MenuFlyoutSubItem>
				</MenuFlyout>
			</Button.Flyout>
		</Button>
		<Button
			Grid.Column="2"
			ToolTipService.ToolTip="{x:Bind ViewModel.LayoutLabel, Mode=OneWay}"
			AutomationProperties.Name="{x:Bind ViewModel.LayoutLabel, Mode=OneWay}"
			IsEnabled="{x:Bind ViewModel.LayoutDetailsCommand.IsEnabled, Mode=OneWay}">
			<FontIcon FontSize="18" Glyph="{x:Bind ViewModel.LayoutGlyph, Mode=OneWay}" />
			<Button.Flyout>
				<Flyout x:Name="LayoutFlyout" Placement="Bottom">
					<StackPanel Padding="4" Spacing="8">
						<TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.LayoutLabel, Mode=OneWay}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<RadioButton
								AutomationProperties.Name="{x:Bind ViewModel.LayoutDetailsCommand.AutomationName, Mode=OneWay}"
								Click="LayoutButton_Click"
								Command="{x:Bind ViewModel.LayoutDetailsCommand.Command}"
								GroupName="LayoutRadio"
								IsChecked="{x:Bind ViewModel.LayoutDetailsCommand.IsChecked, Mode=OneWay}"
								IsEnabled="{x:Bind ViewModel.LayoutDetailsCommand.IsEnabled, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind ViewModel.LayoutDetailsCommand.ToolTip, Mode=OneWay}">
								<StackPanel Spacing="4">
									<FontIcon FontSize="28" Glyph="&#xE8A9;" />
									<TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.LayoutDetailsCommand.Label, Mode=OneWay}" />
								</StackPanel>
							</RadioButton>
							<RadioButton
								AutomationProperties.Name="{x:Bind ViewModel.LayoutListCommand.AutomationName, Mode=OneWay}"
								Click="LayoutButton_Click"
								Command="{x:Bind ViewModel.LayoutListCommand.Command}"
								GroupName="LayoutRadio"
								IsChecked="{x:Bind ViewModel.LayoutListCommand.IsChecked, Mode=OneWay}"
								IsEnabled="{x:Bind ViewModel.LayoutListCommand.IsEnabled, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind ViewModel.LayoutListCommand.ToolTip, Mode=OneWay}">
								<StackPanel Spacing="4">
									<FontIcon FontSize="28" Glyph="&#xE8FD;" />
									<TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.LayoutListCommand.Label, Mode=OneWay}" />
								</StackPanel>
							</RadioButton>
							<RadioButton
								AutomationProperties.Name="{x:Bind ViewModel.LayoutGridCommand.AutomationName, Mode=OneWay}"
								Click="LayoutButton_Click"
								Command="{x:Bind ViewModel.LayoutGridCommand.Command}"
								GroupName="LayoutRadio"
								IsChecked="{x:Bind ViewModel.LayoutGridCommand.IsChecked, Mode=OneWay}"
								IsEnabled="{x:Bind ViewModel.LayoutGridCommand.IsEnabled, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind ViewModel.LayoutGridCommand.ToolTip, Mode=OneWay}">
								<StackPanel Spacing="4">
									<FontIcon FontSize="28" Glyph="&#xECA5;" />
									<TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.LayoutGridCommand.Label, Mode=OneWay}" />
								</StackPanel>
							</RadioButton>
						</StackPanel>
					</StackPanel>
				</Flyout>
			</Button.Flyout>
		</Button>
		<Button
			Grid.Column="3"
			ToolTipService.ToolTip="{x:Bind ViewModel.NewPaneCommand.ToolTip, Mode=OneWay}"
			AutomationProperties.Name="{x:Bind ViewModel.NewPaneCommand.AutomationName, Mode=OneWay}"
			Command="{x:Bind ViewModel.NewPaneCommand.Command}"
			IsEnabled="{x:Bind ViewModel.NewPaneCommand.IsEnabled, Mode=OneWay}">
			<SymbolIcon Symbol="Add" />
		</Button>
		<Button
			Grid.Column="4"
			ToolTipService.ToolTip="{x:Bind ViewModel.ClosePaneCommand.ToolTip, Mode=OneWay}"
			AutomationProperties.Name="{x:Bind ViewModel.ClosePaneCommand.AutomationName, Mode=OneWay}"
			Command="{x:Bind ViewModel.ClosePaneCommand.Command}"
			IsEnabled="{x:Bind ViewModel.ClosePaneCommand.IsEnabled, Mode=OneWay}">
			<SymbolIcon Symbol="Cancel" />
		</Button>
	</Grid>
</UserControl>
