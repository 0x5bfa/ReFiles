<UserControl
	x:Class="Files.Views.ListFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<ListView
		x:Name="ItemList"
		IsMultiSelectCheckBoxEnabled="False"
		ItemsSource="{x:Bind ViewModel.ItemsViewSource.View, Mode=OneWay}"
		SelectionMode="Extended">
		<ListView.ItemContainerTransitions>
			<TransitionCollection />
		</ListView.ItemContainerTransitions>
		<ListView.ItemContainerStyle>
			<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			</Style>
		</ListView.ItemContainerStyle>
		<ListView.GroupStyle>
			<GroupStyle>
				<GroupStyle.HeaderTemplate>
					<DataTemplate x:DataType="vm:BrowseItemGroupViewModel">
						<StackPanel Padding="12,10,12,6" Orientation="Horizontal" Spacing="8">
							<TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
							<TextBlock Opacity="0.65" Text="{x:Bind CountText}" />
						</StackPanel>
					</DataTemplate>
				</GroupStyle.HeaderTemplate>
			</GroupStyle>
		</ListView.GroupStyle>

		<ListView.ItemTemplate>
			<DataTemplate x:DataType="vm:BrowseItemViewModel">
				<Grid MinHeight="{Binding ViewModel.ListItemHeight, ElementName=Root}" Padding="12,6" ColumnSpacing="12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="120" />
					</Grid.ColumnDefinitions>
					<Grid
						Width="{Binding ViewModel.ListThumbnailSize, ElementName=Root}"
						Height="{Binding ViewModel.ListThumbnailSize, ElementName=Root}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<FontIcon
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="{Binding ViewModel.ListThumbnailSize, ElementName=Root}"
							Glyph="&#xE8B7;"
							Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}"
							Visibility="{x:Bind DefaultIconVisibility, Mode=OneWay}" />
						<Image
							Opacity="{x:Bind IconOpacity, Mode=OneWay}"
							Source="{x:Bind Thumbnail, Mode=OneWay}"
							Stretch="Uniform" />
					</Grid>
					<StackPanel Grid.Column="1" Spacing="2">
						<TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
						<TextBlock Opacity="0.7" Text="{x:Bind Kind}" />
					</StackPanel>
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						Opacity="0.7"
						Text="{x:Bind ReferenceText}"
						TextTrimming="CharacterEllipsis" />
				</Grid>
			</DataTemplate>
		</ListView.ItemTemplate>

	</ListView>

</UserControl>
