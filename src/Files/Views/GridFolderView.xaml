<UserControl
	x:Class="Files.Views.GridFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.Controls"
	xmlns:selection="using:Files.Views.Selection"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<controls:RectangleSelectionHost>
		<GridView
			x:Name="ItemGrid"
			controls:RectangleSelection.IsTarget="True"
			ItemsSource="{x:Bind ViewModel.ItemsViewSource.View, Mode=OneWay}"
			selection:FolderViewInteraction.ViewModel="{x:Bind ViewModel, Mode=OneWay}"
			SelectionMode="Extended">
			<GridView.ItemContainerTransitions>
				<TransitionCollection />
			</GridView.ItemContainerTransitions>
			<GridView.ItemContainerStyle>
				<Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Stretch" />
				</Style>
			</GridView.ItemContainerStyle>
			<GridView.GroupStyle>
				<GroupStyle>
					<GroupStyle.HeaderTemplate>
						<DataTemplate x:DataType="vm:BrowseItemGroupViewModel">
							<StackPanel
								Padding="12,10,12,6"
								Orientation="Horizontal"
								Spacing="8">
								<TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
								<TextBlock Opacity="0.65" Text="{x:Bind CountText}" />
							</StackPanel>
						</DataTemplate>
					</GroupStyle.HeaderTemplate>
				</GroupStyle>
			</GridView.GroupStyle>

			<GridView.ItemTemplate>
				<DataTemplate x:DataType="vm:BrowseItemViewModel">
					<StackPanel
						Width="{Binding ViewModel.GridItemSize, ElementName=Root}"
						MinHeight="{Binding ViewModel.GridItemSize, ElementName=Root}"
						Padding="10"
						AutomationProperties.Name="{x:Bind DisplayName}"
						Spacing="8">
						<Grid
							Width="{Binding ViewModel.GridThumbnailSize, ElementName=Root}"
							Height="{Binding ViewModel.GridThumbnailSize, ElementName=Root}"
							HorizontalAlignment="Center">
							<FontIcon
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="{Binding ViewModel.GridDefaultIconSize, ElementName=Root}"
								Glyph="&#xE8B7;"
								Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}"
								Visibility="{x:Bind DefaultIconVisibility, Mode=OneWay}" />
							<Image
								Opacity="{x:Bind IconOpacity, Mode=OneWay}"
								Source="{x:Bind Thumbnail, Mode=OneWay}"
								Stretch="Uniform" />
						</Grid>
						<TextBlock
							HorizontalAlignment="Center"
							Text="{x:Bind DisplayName}"
							TextAlignment="Center"
							TextTrimming="CharacterEllipsis"
							TextWrapping="Wrap" />
					</StackPanel>
				</DataTemplate>
			</GridView.ItemTemplate>

		</GridView>
	</controls:RectangleSelectionHost>

</UserControl>
