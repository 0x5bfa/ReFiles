<UserControl
	x:Class="Files.Views.GridFolderView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">

	<GridView
		x:Name="ItemGrid"
		ItemsSource="{x:Bind ViewModel.ItemsViewSource.View, Mode=OneWay}"
		SelectionMode="Extended">
		<GridView.ItemContainerTransitions>
			<TransitionCollection />
		</GridView.ItemContainerTransitions>
		<GridView.ItemContainerStyle>
			<Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="VerticalContentAlignment" Value="Stretch" />
			</Style>
		</GridView.ItemContainerStyle>
		<GridView.GroupStyle>
			<GroupStyle>
				<GroupStyle.HeaderTemplate>
					<DataTemplate x:DataType="vm:BrowseItemGroupViewModel">
						<StackPanel Padding="12,10,12,6" Orientation="Horizontal" Spacing="8">
							<TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
							<TextBlock Opacity="0.65" Text="{x:Bind CountText}" />
						</StackPanel>
					</DataTemplate>
				</GroupStyle.HeaderTemplate>
			</GroupStyle>
		</GridView.GroupStyle>

		<GridView.ItemTemplate>
			<DataTemplate x:DataType="vm:BrowseItemViewModel">
				<StackPanel
					Width="156"
					MinHeight="156"
					Padding="10"
					AutomationProperties.Name="{x:Bind Name}"
					Spacing="8">
					<Grid
						Width="112"
						Height="112"
						HorizontalAlignment="Center">
						<FontIcon
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="64"
							Glyph="&#xE8B7;"
							Opacity="0.45"
							Visibility="{x:Bind DefaultIconVisibility, Mode=OneWay}" />
						<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
					</Grid>
					<TextBlock
						HorizontalAlignment="Center"
						Text="{x:Bind Name}"
						TextAlignment="Center"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />
				</StackPanel>
			</DataTemplate>
		</GridView.ItemTemplate>

	</GridView>

</UserControl>
