<UserControl
	x:Class="Files.Views.FolderBrowser"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.Views"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">
	<ContentPresenter x:Name="FolderViewPresenter">
		<ContentPresenter.Resources>
			<DataTemplate x:Key="DetailsTemplate" x:DataType="vm:FolderBrowserViewModel">
				<local:DetailsFolderView ViewModel="{x:Bind}" />
			</DataTemplate>
			<DataTemplate x:Key="CardsTemplate" x:DataType="vm:FolderBrowserViewModel">
				<local:CardsFolderView ViewModel="{x:Bind}" />
			</DataTemplate>
			<DataTemplate x:Key="GridTemplate" x:DataType="vm:FolderBrowserViewModel">
				<local:GridFolderView ViewModel="{x:Bind}" />
			</DataTemplate>
			<DataTemplate x:Key="ListTemplate" x:DataType="vm:FolderBrowserViewModel">
				<local:ListFolderView ViewModel="{x:Bind}" />
			</DataTemplate>
			<DataTemplate x:Key="ColumnsTemplate" x:DataType="vm:FolderBrowserViewModel">
				<local:DetailsFolderView ViewModel="{x:Bind}" />
			</DataTemplate>
		</ContentPresenter.Resources>
	</ContentPresenter>
</UserControl>
