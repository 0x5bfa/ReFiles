<UserControl
	x:Class="Files.Views.FolderBrowser"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:local="using:Files.Views"
	xmlns:localization="using:Files.Localization"
	xmlns:vm="using:Files.ViewModels"
	x:Name="Root">
	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</UserControl.Resources>

	<Grid>
		<ContentPresenter x:Name="FolderViewPresenter">
			<ContentPresenter.Resources>
				<DataTemplate x:Key="DetailsTemplate" x:DataType="vm:FolderBrowserViewModel">
					<local:DetailsFolderView ViewModel="{x:Bind}" />
				</DataTemplate>
				<DataTemplate x:Key="CardsTemplate" x:DataType="vm:FolderBrowserViewModel">
					<local:CardsFolderView ViewModel="{x:Bind}" />
				</DataTemplate>
				<DataTemplate x:Key="GridTemplate" x:DataType="vm:FolderBrowserViewModel">
					<local:GridFolderView ViewModel="{x:Bind}" />
				</DataTemplate>
				<DataTemplate x:Key="ListTemplate" x:DataType="vm:FolderBrowserViewModel">
					<local:ListFolderView ViewModel="{x:Bind}" />
				</DataTemplate>
				<DataTemplate x:Key="ColumnsTemplate" x:DataType="vm:FolderBrowserViewModel">
					<local:DetailsFolderView ViewModel="{x:Bind}" />
				</DataTemplate>
			</ContentPresenter.Resources>
		</ContentPresenter>

		<TextBlock
			Margin="24,72,24,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			IsHitTestVisible="False"
			Opacity="0.7"
			Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
			TextAlignment="Center"
			TextWrapping="Wrap"
			Visibility="{x:Bind ViewModel.IsFolderEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
	</Grid>
</UserControl>
