<UserControl
	x:Class="Files.Views.NavigationToolbar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root">

	<Grid Padding="8,0,8,8" ColumnSpacing="6">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Button
			Height="32"
			AutomationProperties.Name="{x:Bind ViewModel.BackCommand.AutomationName, Mode=OneWay}"
			Background="Transparent"
			BorderBrush="Transparent"
			Command="{x:Bind ViewModel.BackCommand.Command}"
			IsEnabled="{x:Bind ViewModel.BackCommand.IsEnabled, Mode=OneWay}"
			ToolTipService.ToolTip="{x:Bind ViewModel.BackCommand.ToolTip, Mode=OneWay}">
			<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.BackCommand.Glyph, Mode=OneWay}" />
		</Button>
		<Button
			Grid.Column="1"
			Height="32"
			AutomationProperties.Name="{x:Bind ViewModel.ForwardCommand.AutomationName, Mode=OneWay}"
			Background="Transparent"
			BorderBrush="Transparent"
			Command="{x:Bind ViewModel.ForwardCommand.Command}"
			IsEnabled="{x:Bind ViewModel.ForwardCommand.IsEnabled, Mode=OneWay}"
			ToolTipService.ToolTip="{x:Bind ViewModel.ForwardCommand.ToolTip, Mode=OneWay}">
			<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.ForwardCommand.Glyph, Mode=OneWay}" />
		</Button>
		<Button
			Grid.Column="2"
			Height="32"
			AutomationProperties.Name="{x:Bind ViewModel.UpCommand.AutomationName, Mode=OneWay}"
			Background="Transparent"
			BorderBrush="Transparent"
			Command="{x:Bind ViewModel.UpCommand.Command}"
			IsEnabled="{x:Bind ViewModel.UpCommand.IsEnabled, Mode=OneWay}"
			ToolTipService.ToolTip="{x:Bind ViewModel.UpCommand.ToolTip, Mode=OneWay}">
			<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.UpCommand.Glyph, Mode=OneWay}" />
		</Button>
		<Button
			Grid.Column="3"
			Height="32"
			AutomationProperties.Name="{x:Bind ViewModel.HomeCommand.AutomationName, Mode=OneWay}"
			Background="Transparent"
			BorderBrush="Transparent"
			Command="{x:Bind ViewModel.HomeCommand.Command}"
			IsEnabled="{x:Bind ViewModel.HomeCommand.IsEnabled, Mode=OneWay}"
			ToolTipService.ToolTip="{x:Bind ViewModel.HomeCommand.ToolTip, Mode=OneWay}">
			<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.HomeCommand.Glyph, Mode=OneWay}" />
		</Button>
		<Button
			Grid.Column="5"
			Height="32"
			AutomationProperties.Name="{x:Bind ViewModel.RefreshCommand.AutomationName, Mode=OneWay}"
			Command="{x:Bind ViewModel.RefreshCommand.Command}"
			IsEnabled="{x:Bind ViewModel.RefreshCommand.IsEnabled, Mode=OneWay}"
			ToolTipService.ToolTip="{x:Bind ViewModel.RefreshCommand.ToolTip, Mode=OneWay}">
			<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.RefreshCommand.Glyph, Mode=OneWay}" />
		</Button>

		<TextBox
			x:Name="PathTextBox"
			Grid.Column="4"
			MinWidth="260"
			HorizontalAlignment="Stretch"
			KeyDown="PathTextBox_KeyDown"
			PlaceholderText="{x:Bind ViewModel.PathPlaceholderText, Mode=OneWay}"
			Text="{x:Bind ViewModel.LocationText, Mode=OneWay}" />

	</Grid>
</UserControl>
