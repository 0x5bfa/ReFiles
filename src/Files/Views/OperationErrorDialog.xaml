<ContentDialog
	x:Class="Files.Views.OperationErrorDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:localization="using:Files.Localization"
	CloseButtonText="{localization:Localized ResourceKey=Ok}"
	DefaultButton="Close"
	Style="{StaticResource DefaultContentDialogStyle}"
	Title="{localization:Localized ResourceKey=StorageOperationUnexpectedTitle}">

	<TextBlock MaxWidth="520" Text="{x:Bind Message}" TextWrapping="Wrap" />
</ContentDialog>
