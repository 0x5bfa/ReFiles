<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<OutputType>WinExe</OutputType>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<BackgroundServerProject>$(MSBuildProjectDirectory)\..\Files.BackgroundServer\Files.BackgroundServer.csproj</BackgroundServerProject>
		<BackgroundServerPublishDir>$(MSBuildProjectDirectory)\obj\Files.BackgroundServer\$(Platform)\$(Configuration)\$(TargetFramework)\publish\</BackgroundServerPublishDir>
		<BackgroundServerWinmd>$(MSBuildProjectDirectory)\..\Files.BackgroundServer\bin\$(Platform)\$(Configuration)\$(TargetFramework)\Files.BackgroundServer.winmd</BackgroundServerWinmd>
		<LauncherProject>$(MSBuildProjectDirectory)\..\FilesLauncher\FilesLauncher.csproj</LauncherProject>
		<LauncherPublishDir>$(MSBuildProjectDirectory)\obj\FilesLauncher\$(Platform)\$(Configuration)\$(TargetFramework)\publish\</LauncherPublishDir>
		<CsWinRTIncludes>Files.BackgroundServer;$(CsWinRTIncludes)</CsWinRTIncludes>
	</PropertyGroup>

	<ItemGroup>
		<Manifest Include="app.manifest" />
		<Content Update="Assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" />
		<PackageReference Include="CommunityToolkit.WinUI.Extensions" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Files.BackgroundServer\Files.BackgroundServer.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\Files.Core\Files.Core.csproj" />
		<ProjectReference Include="..\Files.Controls\Files.Controls.csproj" />
		<ProjectReference Include="..\Files.SourceGenerators\Files.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\FilesLauncher\FilesLauncher.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
		<AdditionalFiles Include="Strings\en-US\Resources.resw" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Files.UITests" />
	</ItemGroup>

	<ItemGroup>
		<CsWinRTInputs Include="$(BackgroundServerWinmd)" />
		<None Include="$(BackgroundServerWinmd)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Files.BackgroundServer.winmd</Link>
			<Visible>false</Visible>
		</None>
	</ItemGroup>

	<Target Name="VerifyBackgroundServerMetadata" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(BackgroundServerWinmd)')" Text="Files.BackgroundServer WinRT metadata was not generated." />
	</Target>

	<Target Name="PublishLauncher" BeforeTargets="_ComputeAppxPackagePayload" Condition="'$(AppxPackage)' == 'true'">
		<MSBuild Projects="$(LauncherProject)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-$(Platform);SelfContained=true;PublishAot=true;PublishDir=$(LauncherPublishDir)" />
		<Error Condition="!Exists('$(LauncherPublishDir)FilesLauncher.exe')" Text="FilesLauncher publish output was not found." />
		<ItemGroup>
			<AppxPackagePayload Include="$(LauncherPublishDir)FilesLauncher.exe" TargetPath="FilesLauncher.exe" />
		</ItemGroup>
	</Target>

	<Target Name="PublishBackgroundServer" BeforeTargets="_ComputeAppxPackagePayload" Condition="'$(AppxPackage)' == 'true'">
		<MSBuild Projects="$(BackgroundServerProject)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-$(Platform);SelfContained=true;PublishAot=true;PublishDir=$(BackgroundServerPublishDir)" />
		<Error Condition="!Exists('$(BackgroundServerPublishDir)Files.BackgroundServer.exe')" Text="Files.BackgroundServer publish output was not found." />
		<ItemGroup>
			<_FilesBackgroundServerPackageFile Include="$(BackgroundServerPublishDir)**\*" Exclude="$(BackgroundServerPublishDir)**\*.winmd;$(BackgroundServerPublishDir)**\*.pdb" />
			<AppxPackagePayload Include="@(_FilesBackgroundServerPackageFile)" TargetPath="Files.BackgroundServer\%(RecursiveDir)%(Filename)%(Extension)" />
		</ItemGroup>
	</Target>

</Project>
