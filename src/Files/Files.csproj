<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<OutputType>WinExe</OutputType>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
		<PublishAot>true</PublishAot>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<OperationsServerProject>$(MSBuildProjectDirectory)\..\Files.Operations\Files.Operations.csproj</OperationsServerProject>
		<OperationsServerWinmd>$(MSBuildProjectDirectory)\..\Files.Operations\bin\$(Platform)\$(Configuration)\$(TargetFramework)\win-$(Platform)\Files.Operations.winmd</OperationsServerWinmd>
		<CsWinRTIncludes>Files.Operations;$(CsWinRTIncludes)</CsWinRTIncludes>
	</PropertyGroup>

	<ItemGroup>
		<Manifest Include="app.manifest" />
		<Content Update="Assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" />
		<PackageReference Include="CommunityToolkit.WinUI.Extensions" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<PackageReference Include="Microsoft.WindowsAppSDK" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Files.Core\Files.Core.csproj" />
		<ProjectReference Include="..\Files.Controls\Files.Controls.csproj" />
		<ProjectReference Include="..\Files.SourceGenerators\Files.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="Strings\en-US\Resources.resw" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Files.UITests" />
	</ItemGroup>

	<ItemGroup>
		<CsWinRTInputs Include="$(OperationsServerWinmd)" />
		<None Include="$(OperationsServerWinmd)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Files.Operations.winmd</Link>
			<Visible>false</Visible>
		</None>
	</ItemGroup>

	<Target Name="BuildOperationsServerForCsWinRT" BeforeTargets="ResolveAssemblyReferences">
		<MSBuild Projects="$(OperationsServerProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-$(Platform)" />
		<Error Condition="!Exists('$(OperationsServerWinmd)')" Text="Files.Operations WinRT metadata was not generated." />
	</Target>

	<Target Name="PublishOperationsServerForMsix" BeforeTargets="_ComputeAppxPackagePayload" Condition="'$(AppxPackage)' == 'true'">
		<PropertyGroup>
			<OperationsServerProject>$(MSBuildProjectDirectory)\..\Files.Operations\Files.Operations.csproj</OperationsServerProject>
			<OperationsServerPublishDir>$(MSBuildProjectDirectory)\obj\Files.Operations\$(Platform)\$(Configuration)\$(TargetFramework)\win-$(Platform)\publish\</OperationsServerPublishDir>
		</PropertyGroup>

		<MSBuild Projects="$(OperationsServerProject)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-$(Platform);SelfContained=true;PublishAot=false;PublishDir=$(OperationsServerPublishDir)" />
		<Error Condition="!Exists('$(OperationsServerPublishDir)Files.Operations.exe')" Text="Files.Operations publish output was not found." />

		<ItemGroup>
			<_FilesOperationsPackageFile Include="$(OperationsServerPublishDir)**\*" Exclude="$(OperationsServerPublishDir)**\*.winmd;$(OperationsServerPublishDir)**\*.pdb" />
			<AppxPackagePayload Include="@(_FilesOperationsPackageFile)" TargetPath="Files.Operations\%(RecursiveDir)%(Filename)%(Extension)" />
		</ItemGroup>
	</Target>

</Project>
