<UserControl
	x:Class="Files.ItemProperties.CompatibilityPropertyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer Padding="14,12,14,8">
		<StackPanel Spacing="14">
			<TextBlock Text="{x:Bind Intro}" TextWrapping="Wrap" />
			<Button
				HorizontalAlignment="Left"
				Click="TroubleshooterButton_Click"
				Content="{x:Bind TroubleshooterLabel}" />
			<Border
				Padding="10"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{x:Bind CompatibilityModeLabel}" />
					<CheckBox Content="{x:Bind RunInCompatibilityModeLabel}" IsEnabled="False" />
					<ComboBox
						HorizontalAlignment="Stretch"
						IsEnabled="False"
						ItemsSource="{x:Bind CompatibilityVersions}"
						SelectedIndex="0" />
				</StackPanel>
			</Border>
			<Border
				Padding="10"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{x:Bind SettingsLabel}" />
					<CheckBox Content="{x:Bind ReducedColorModeLabel}" IsEnabled="False" />
					<CheckBox Content="{x:Bind RunIn640By480Label}" IsEnabled="False" />
					<CheckBox Content="{x:Bind DisableFullscreenOptimizationsLabel}" IsEnabled="False" />
					<CheckBox Content="{x:Bind RunAsAdministratorLabel}" IsEnabled="False" />
					<Button
						HorizontalAlignment="Left"
						Click="HighDpiButton_Click"
						Content="{x:Bind ChangeHighDpiSettingsLabel}" />
				</StackPanel>
			</Border>
			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{x:Bind ProgramLabel}" />
				<TextBlock
					Grid.Column="1"
					IsTextSelectionEnabled="True"
					Text="{x:Bind Compatibility.ExecutablePath}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</StackPanel>
	</ScrollViewer>
</UserControl>
