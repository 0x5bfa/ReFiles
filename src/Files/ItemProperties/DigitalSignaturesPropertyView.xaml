<UserControl
	x:Class="Files.ItemProperties.DigitalSignaturesPropertyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.ItemProperties"
	xmlns:localization="using:Files.Localization">

	<ScrollViewer>

		<StackPanel Margin="12,0,12,12" Spacing="12">

			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=EmbeddedSignatures}" />
					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=SignerName}" />
						<TextBlock
							Grid.Column="1"
							FontWeight="SemiBold"
							Text="{localization:Localized ResourceKey=DigestAlgorithm}" />
						<TextBlock
							Grid.Column="2"
							FontWeight="SemiBold"
							Text="{localization:Localized ResourceKey=Timestamp}" />
					</Grid>
					<ListView
						Height="120"
						ItemsSource="{x:Bind EmbeddedSignatures}"
						SelectionMode="Single">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="local:SignatureDisplayRow">
								<Grid ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="{x:Bind Signer}" TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="1"
										Text="{x:Bind DigestAlgorithm}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="2"
										Text="{x:Bind ThirdColumn}"
										TextTrimming="CharacterEllipsis" />
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<TextBlock
						HorizontalAlignment="Center"
						Text="{localization:Localized ResourceKey=NoSignatures}"
						Visibility="{x:Bind EmbeddedEmptyVisibility}" />
					<Button
						HorizontalAlignment="Right"
						Content="{localization:Localized ResourceKey=Details}"
						IsEnabled="False" />
				</StackPanel>
			</Border>

			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=CatalogSignatures}" />
					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=SignerName}" />
						<TextBlock
							Grid.Column="1"
							FontWeight="SemiBold"
							Text="{localization:Localized ResourceKey=DigestAlgorithm}" />
						<TextBlock
							Grid.Column="2"
							FontWeight="SemiBold"
							Text="{localization:Localized ResourceKey=CatalogName}" />
					</Grid>
					<ListView
						Height="120"
						ItemsSource="{x:Bind CatalogSignatures}"
						SelectionMode="Single">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="local:SignatureDisplayRow">
								<Grid ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="{x:Bind Signer}" TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="1"
										Text="{x:Bind DigestAlgorithm}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										Grid.Column="2"
										Text="{x:Bind ThirdColumn}"
										TextTrimming="CharacterEllipsis" />
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<TextBlock
						HorizontalAlignment="Center"
						Text="{localization:Localized ResourceKey=NoSignatures}"
						Visibility="{x:Bind CatalogEmptyVisibility}" />
					<Button
						HorizontalAlignment="Right"
						Content="{localization:Localized ResourceKey=Details}"
						IsEnabled="False" />
				</StackPanel>
			</Border>

		</StackPanel>

	</ScrollViewer>

</UserControl>
