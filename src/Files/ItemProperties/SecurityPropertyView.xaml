<UserControl
	x:Class="Files.ItemProperties.SecurityPropertyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.ItemProperties">

	<ScrollViewer Padding="12,0,12,12">
		<StackPanel Spacing="14">

			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{x:Bind ObjectNameLabel}" />
				<TextBlock
					Grid.Column="1"
					Text="{x:Bind Security.ObjectPath}"
					TextTrimming="CharacterEllipsis" />
			</Grid>

			<TextBlock Text="{x:Bind GroupOrUserNamesLabel}" />

			<Border
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<ListView
					x:Name="PrincipalList"
					Height="160"
					ItemsSource="{x:Bind Principals}"
					SelectionChanged="PrincipalList_SelectionChanged"
					SelectionMode="Single">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="local:SecurityPrincipalViewModel">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
								<TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>

			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{x:Bind EditDescription}" TextWrapping="Wrap" />
				<Button
					Grid.Column="1"
					Click="Edit_Click">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<local:ElevationShieldIcon Visibility="{x:Bind EditShieldVisibility}" />
						<TextBlock Text="{x:Bind EditLabel}" />
					</StackPanel>
				</Button>
			</Grid>

			<TextBlock x:Name="PermissionsTitle" FontWeight="SemiBold" />

			<Grid
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				ColumnSpacing="12"
				CornerRadius="{StaticResource OverlayCornerRadius}"
				RowSpacing="6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="64" />
					<ColumnDefinition Width="64" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{x:Bind AllowLabel}" />
				<TextBlock
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{x:Bind DenyLabel}" />
				<TextBlock Grid.Row="1" Text="{x:Bind FullControlLabel}" />
				<TextBlock
					x:Name="FullControlAllow"
					Grid.Row="1"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="FullControlDeny"
					Grid.Row="1"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock Grid.Row="2" Text="{x:Bind ModifyLabel}" />
				<TextBlock
					x:Name="ModifyAllow"
					Grid.Row="2"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="ModifyDeny"
					Grid.Row="2"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock Grid.Row="3" Text="{x:Bind ReadAndExecuteLabel}" />
				<TextBlock
					x:Name="ReadAndExecuteAllow"
					Grid.Row="3"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="ReadAndExecuteDeny"
					Grid.Row="3"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock Grid.Row="4" Text="{x:Bind ListFolderContentsLabel}" />
				<TextBlock
					x:Name="ListFolderContentsAllow"
					Grid.Row="4"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="ListFolderContentsDeny"
					Grid.Row="4"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock Grid.Row="5" Text="{x:Bind ReadLabel}" />
				<TextBlock
					x:Name="ReadAllow"
					Grid.Row="5"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="ReadDeny"
					Grid.Row="5"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock Grid.Row="6" Text="{x:Bind WriteLabel}" />
				<TextBlock
					x:Name="WriteAllow"
					Grid.Row="6"
					Grid.Column="1"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
				<TextBlock
					x:Name="WriteDeny"
					Grid.Row="6"
					Grid.Column="2"
					HorizontalAlignment="Center"
					FontFamily="Segoe Fluent Icons" />
			</Grid>

			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{x:Bind AdvancedDescription}" TextWrapping="Wrap" />
				<Button
					Grid.Column="1"
					Click="Advanced_Click"
					Content="{x:Bind AdvancedLabel}" />
			</Grid>
		</StackPanel>
	</ScrollViewer>

</UserControl>
