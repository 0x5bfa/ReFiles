<UserControl
	x:Class="Files.ItemProperties.CustomizePropertyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:itemProperties="using:Files.ItemProperties"
	xmlns:localization="using:Files.Localization"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	Loaded="UserControl_Loaded">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</UserControl.Resources>

	<ScrollViewer Padding="12,0,12,12">

		<StackPanel Spacing="14">
			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=FolderCustomizationQuestion}" />
					<TextBlock Text="{localization:Localized ResourceKey=OptimizeFolderFor}" />
					<ComboBox
						x:Name="FolderKindComboBox"
						HorizontalAlignment="Stretch"
						ItemsSource="{x:Bind FolderKinds}"
						SelectionChanged="FolderKindComboBox_SelectionChanged">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="itemProperties:FolderKindOption">
								<TextBlock Text="{x:Bind DisplayName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<CheckBox
						x:Name="ApplyToSubfoldersCheckBox"
						Click="ApplyToSubfoldersCheckBox_Click"
						Content="{localization:Localized ResourceKey=ApplyTemplateToSubfolders}" />
				</StackPanel>
			</Border>
			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}"
				Visibility="{x:Bind Customization.CanChangePicture, Converter={StaticResource BoolToVisibilityConverter}}">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=FolderPictures}" />
					<TextBlock Text="{localization:Localized ResourceKey=FolderPicturesDescription}" TextWrapping="Wrap" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Click="ChooseFileButton_Click" Content="{localization:Localized ResourceKey=ChooseFile}" />
						<Button Click="RestorePictureButton_Click" Content="{localization:Localized ResourceKey=RestoreDefault}" />
					</StackPanel>
				</StackPanel>
			</Border>
			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}"
				Visibility="{x:Bind Customization.CanChangeIcon, Converter={StaticResource BoolToVisibilityConverter}}">
				<StackPanel Spacing="8">
					<TextBlock FontWeight="SemiBold" Text="{localization:Localized ResourceKey=FolderIcons}" />
					<TextBlock Text="{localization:Localized ResourceKey=FolderIconsDescription}" TextWrapping="Wrap" />
					<Grid ColumnSpacing="16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Button
							VerticalAlignment="Center"
							Click="ChangeIconButton_Click"
							Content="{localization:Localized ResourceKey=ChangeIcon}" />
						<Image
							x:Name="FolderIconImage"
							Grid.Column="1"
							Width="48"
							Height="48"
							HorizontalAlignment="Left" />
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

	</ScrollViewer>

</UserControl>
