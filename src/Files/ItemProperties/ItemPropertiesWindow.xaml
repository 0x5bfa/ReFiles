<Window
	x:Class="Files.ItemProperties.ItemPropertiesWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<FontIcon
			Grid.Row="0"
			Margin="0,0,0,12"
			HorizontalAlignment="Left"
			FontSize="36"
			Glyph="&#xE946;" />

		<TextBlock
			Grid.Row="1"
			Margin="0,0,0,24"
			Style="{ThemeResource TitleTextBlockStyle}"
			Text="{x:Bind ViewModel.Name}" />

		<Grid Grid.Row="2" ColumnSpacing="24" RowSpacing="14">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind ViewModel.TypeLabel}" />
			<TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Type}" TextWrapping="Wrap" />
			<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind ViewModel.LocationLabel}" />
			<TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Location}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
			<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind ViewModel.SizeLabel}" />
			<TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Size}" />
			<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind ViewModel.DateCreatedLabel}" />
			<TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DateCreated}" />
			<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind ViewModel.DateModifiedLabel}" />
			<TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.DateModified}" />
		</Grid>

		<Button
			Grid.Row="3"
			Margin="0,24,0,0"
			HorizontalAlignment="Right"
			Click="CloseButton_Click"
			Content="{x:Bind ViewModel.CloseLabel}" />
	</Grid>
</Window>
