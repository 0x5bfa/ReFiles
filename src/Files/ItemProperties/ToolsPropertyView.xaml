<UserControl
	x:Class="Files.ItemProperties.ToolsPropertyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.ItemProperties">

	<ScrollViewer Padding="12,0,12,12">

		<StackPanel Spacing="12">
			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<StackPanel Spacing="10">
					<TextBlock FontWeight="SemiBold" Text="{x:Bind ErrorCheckingLabel}" />
					<TextBlock Text="{x:Bind ErrorCheckingDescription}" TextWrapping="Wrap" />
					<Button
						HorizontalAlignment="Left"
						Click="CheckButton_Click"
						IsEnabled="{x:Bind Drive.SupportsErrorChecking}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<local:ElevationShieldIcon />
							<TextBlock Text="{x:Bind CheckLabel}" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>

			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource OverlayCornerRadius}">
				<StackPanel Spacing="10">
					<TextBlock FontWeight="SemiBold" Text="{x:Bind OptimizeAndDefragmentLabel}" />
					<TextBlock Text="{x:Bind OptimizeDescription}" TextWrapping="Wrap" />
					<Button
						HorizontalAlignment="Left"
						Click="OptimizeButton_Click"
						Content="{x:Bind OptimizeLabel}"
						IsEnabled="{x:Bind Drive.SupportsOptimization}" />
				</StackPanel>
			</Border>
		</StackPanel>

	</ScrollViewer>

</UserControl>
