<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFramework)</TargetFramework>
		<TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64;arm64</Platforms>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>ReFiles.Core.Contracts</PackageId>
		<Version>0.1.1</Version>
		<Authors>0x5bfa</Authors>
		<Description>Consumer contracts for ReFiles storage, browsing, and capabilities.</Description>
		<PackageLicenseFile>LICENSE-MPL</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Packaging/ReFiles.Core.Contracts.targets" Pack="true" PackagePath="buildTransitive/ReFiles.Core.Contracts.targets" />
		<None Include="../../LICENSE-MPL" Pack="true" PackagePath="" Visible="false" />
		<InternalsVisibleTo Include="Files.Core" />
		<InternalsVisibleTo Include="Files.Core.ProviderContracts" />
		<InternalsVisibleTo Include="Files.Providers" />
		<InternalsVisibleTo Include="Files.UnitTests" />
	</ItemGroup>

	<!-- NuGet restore cannot take SDK version defaults from package imports; validate the consumer setting instead. -->
	<Target Name="PackWindowsSdkProjectionDefaults" BeforeTargets="_GetPackageFiles">
		<PropertyGroup>
			<_ProjectionDefaults>$(IntermediateOutputPath)ReFiles.Core.Contracts.props</_ProjectionDefaults>
		</PropertyGroup>
		<WriteLinesToFile File="$(_ProjectionDefaults)" Overwrite="true" Encoding="UTF-8"
			Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;ReFilesRequiredWindowsSdkPackageVersion&gt;$(WindowsSdkPackageVersion)&lt;/ReFilesRequiredWindowsSdkPackageVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
		<ItemGroup>
			<None Include="$(_ProjectionDefaults)" Pack="true" PackagePath="buildTransitive/ReFiles.Core.Contracts.props" />
		</ItemGroup>
	</Target>
</Project>
